# FastAPI RestKit Environment Variables

# PyPI Publishing Tokens
# Get your token from: https://pypi.org/manage/account/token/
PYPI_TOKEN=pypi-your-token-here

# TestPyPI Token (for testing before real publish)
# Get your token from: https://test.pypi.org/manage/account/token/
PYPI_TEST_TOKEN=pypi-your-test-token-here

# Pagination Settings (optional)
# RESTKIT_DEFAULT_PAGE_SIZE=10
# RESTKIT_MAX_PAGE_SIZE=100
